# Browser-visible public Supabase project endpoint and publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# To use the visible Google login buttons, enable Google OAuth in Supabase Auth and
# allow the /auth/callback (merchant) and /auth/customer/callback (customer)
# redirect URLs, including their query strings, in the Supabase Auth allowlist.
# Enable "Manual Linking" in Auth settings to upgrade a guest with saved memories.

# Public canonical origin for metadata/sitemap after deployment (optional in development).
NEXT_PUBLIC_SITE_URL=https://YOUR_DEPLOYED_DOMAIN.example

# Only if your reverse proxy OVERWRITES this header on every request (not client-supplied).
# Without this, screen pairing uses one restrictive shared rate-limit bucket.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Server-only key. Never prefix this with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
