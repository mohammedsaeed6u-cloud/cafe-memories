# ---------------------------------------------------------------------------
# Café Memories / Stampy — environment template
#
# Copy to `.env.local` for local development. In production these are Worker
# secrets (`wrangler secret put NAME`), never committed files.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS: treat it like a root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used in wallet passes, QR links, and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session signing secrets. Each must be at least 32 random characters in
# production. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
STAFF_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=

# HMAC salt for hashing visitor IP addresses (anti-fraud). At least 16 chars.
ANTI_FRAUD_SALT=

# WalletWallet (https://walletwallet.dev) live API key for Apple/Google passes.
WALLETWALLET_API_KEY=ww_live_xxxxxxxxxxxxxxxxxxxx

# Deployment-level wallet plan: free | pro | business. Pro/business unlock the
# custom logo, branch locations, and the notification field that wallet nudges
# update. A venue-level connector plan overrides this value.
WALLETWALLET_PLAN=free

# Comma-separated emails allowed into /admin (Super Admin portal).
SUPER_ADMIN_EMAILS=owner@example.com

# Optional: static API key for machine-to-machine integrations.
STAMPY_INTEGRATION_API_KEY=

# Optional: default venue slug used by the terminal before pairing.
NEXT_PUBLIC_DEFAULT_CAFE_SLUG=

# Optional: encryption key for stored wallet connector credentials.
WALLET_CONNECTOR_ENCRYPTION_KEY=

# Development only — lets the terminal accept seeded staff PINs without a DB.
ALLOW_DEV_STAFF_PINS=false
