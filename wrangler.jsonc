{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cafe-memories",
  "account_id": "43b83bf4153a4dabda7562e63232952b",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
