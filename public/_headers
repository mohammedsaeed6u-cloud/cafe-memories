# 1. Next.js Static Fingerprinted Assets (1 Year Immutable CDN Cache)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 2. Static Images, Icons, and Media Assets
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.webmanifest
  Cache-Control: public, max-age=86400

# 3. Dynamic API Endpoints (Strictly Never Cached on CDN)
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# 4. Global Security Policies
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com https://api.dicebear.com https://*.supabase.co https://api.walletwallet.dev https://*.walletwallet.dev https://*.cloudflare.com https://*.cloudflareinsights.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.walletwallet.dev https://*.walletwallet.dev https://cloudflareinsights.com https://api.dicebear.com https://images.unsplash.com; media-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self';
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
